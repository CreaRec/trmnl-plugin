# Local / deploy secrets (never commit real ICS URL or poll token)
PORT=8799
HOST=0.0.0.0

# Required in production (Docker NODE_ENV=production). UUID for public poll URL:
#   https://crearec.app/trmnl/<TRMNL_POLL_TOKEN>
# Generate with: uuidgen  (or python -c 'import uuid; print(uuid.uuid4())')
# Never commit a real token — leave empty here; set only in host .env.
TRMNL_POLL_TOKEN=

# Studio layout JSON path (volume-mounted in compose → /app/data/…)
STUDIO_LAYOUT_PATH=/app/data/studio-layout.json

# Published iCloud calendar ICS (https). webcal:// is accepted and rewritten to https://.
# Example placeholder only — put the real URL in a private .env on the host.
CALENDAR_ICS_URL=https://example.com/path/to/published/calendar.ics

# Open-Meteo (no API key) — defaults are Pflugerville TX area
WEATHER_LAT=30.4394
WEATHER_LON=-97.6200
WEATHER_TZ=America/Chicago
