{% comment %}
  Full-screen fridge dashboard for TRMNL BWRY (Private Plugin → Markup → Full).
  Payload: examples/sample-payload.json — weather, waste, 7-day calendar list.
  Battery: TRMNL device var only (trmnl.device.percent_charged) — never invent a server field.
  Platform provides Screen/View; keep layout + title_bar as siblings.
{% endcomment %}

<div class="layout layout--col gap--medium">
  {% comment %} Header: weather (today + compact tomorrow) + optional battery + Sunday waste {% endcomment %}
  <div class="flex flex--row flex--between flex--center-y gap--small">
    <div class="flex flex--col gap--xsmall" style="flex: 1;">
      <div class="flex flex--row flex--center-y gap--small">
        <span class="title title--large">
          {% if weather.today.temp_f %}
            {{ weather.today.temp_f | round }}°
          {% elsif weather.today.temp_c %}
            {{ weather.today.temp_c | round }}°C
          {% else %}
            —
          {% endif %}
        </span>
        <span class="description">{{ weather.today.condition | default: "—" }}</span>
      </div>
      <span class="label">
        {% if weather.today.low_f and weather.today.high_f %}
          {{ weather.today.low_f | round }}° / {{ weather.today.high_f | round }}°
        {% endif %}
        {% if weather.today.humidity %}
          · {{ weather.today.humidity }}%
        {% endif %}
      </span>
      {% if weather.today.precip_slots and weather.today.precip_slots.size > 0 %}
        <span class="label text--yellow">
          {% for slot in weather.today.precip_slots limit: 4 %}
            {{ slot.label }} {{ slot.probability }}{% if slot.mm > 0 %}·{{ slot.mm }}mm{% endif %}{% unless forloop.last %} · {% endunless %}
          {% endfor %}
        </span>
      {% elsif weather.today.precip_summary and weather.today.precip_summary != "No precip" %}
        <span class="label text--yellow">{{ weather.today.precip_summary }}</span>
      {% endif %}
    </div>

    <div class="flex flex--col gap--xsmall" style="text-align: right;">
      <span class="label">Tomorrow</span>
      <span class="description">
        {% if weather.tomorrow.low_f and weather.tomorrow.high_f %}
          {{ weather.tomorrow.low_f | round }}°/{{ weather.tomorrow.high_f | round }}°
        {% endif %}
      </span>
      <span class="label">{{ weather.tomorrow.condition | default: "—" }}</span>
      {% if weather.tomorrow.precip_summary and weather.tomorrow.precip_summary != "No precip" %}
        <span class="label text--yellow">{{ weather.tomorrow.precip_summary | truncate: 28 }}</span>
      {% endif %}
    </div>
  </div>

  <div class="flex flex--row flex--between flex--center-y gap--small">
    <div class="flex flex--row gap--small flex--center-y">
      {% if waste.active %}
        <span class="label {% if waste.kind == 'trash_recycle' %}text--yellow{% else %}text--red{% endif %}">
          {{ waste.label | default: "Bins out" }}
        </span>
      {% endif %}
      {% comment %} Optional device battery — omit when TRMNL does not inject the var {% endcomment %}
      {% if trmnl.device.percent_charged %}
        <span class="label">{{ trmnl.device.percent_charged | round }}%</span>
      {% endif %}
    </div>
    <span class="label">
      {% if updated_at %}
        {{ updated_at | date: "%H:%M" }}
      {% endif %}
    </span>
  </div>

  {% comment %} Main: next 7 days as a list (not a week grid). Waste is not calendar. {% endcomment %}
  <div class="flex flex--col gap--small">
    <span class="label">Next 7 days</span>
    {% if days and days.size > 0 %}
      {% for day in days %}
        <div class="flex flex--col gap--xsmall">
          <span class="{% if day.is_today %}value{% else %}label{% endif %}{% if day.is_today %} text--yellow{% endif %}">
            {{ day.label }}
          </span>
          {% if day.events and day.events.size > 0 %}
            {% for event in day.events %}
              <div class="flex flex--row flex--between flex--center-y gap--small">
                <span class="description" style="flex: 1;">{{ event.title }}</span>
                <span class="label {% if event.all_day %}text--yellow{% endif %}">{{ event.time_label }}</span>
              </div>
            {% endfor %}
          {% else %}
            <span class="description">—</span>
          {% endif %}
        </div>
      {% endfor %}
    {% elsif events and events.size > 0 %}
      {% for event in events %}
        <div class="flex flex--row flex--between flex--center-y gap--small">
          <span class="label">{{ event.day_label }}</span>
          <span class="description" style="flex: 1;">{{ event.title }}</span>
          <span class="label">{{ event.time_label }}</span>
        </div>
      {% endfor %}
    {% else %}
      <span class="description">No upcoming events</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ plugin_label | default: "CreaFridge" }}</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
